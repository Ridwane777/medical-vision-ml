{
  "label_scheme": "kl01_vs_2to4",
  "image_size": 64,
  "balance_train": true,
  "max_per_class": 150,
  "max_per_class_eval": 150,
  "candidates": ["raw_pca_logreg", "raw_pca_svc", "hog_logreg", "hog_svc", "hog_rf", "hog_pca_hgb"],
  "param_grids": {
    "raw_pca_logreg": {"pca__n_components": [30], "logreg__C": [0.01]},
    "raw_pca_svc": {"pca__n_components": [30], "svc__C": [1], "svc__gamma": ["scale"]},
    "hog_logreg": {"logreg__C": [0.001, 0.01]},
    "hog_svc": {"svc__C": [1], "svc__gamma": ["scale"]},
    "hog_rf": {"rf__n_estimators": [100], "rf__max_depth": [10]},
    "hog_pca_hgb": {"pca__n_components": [30], "hgb__learning_rate": [0.1], "hgb__max_iter": [50]}
  },
  "hog": {"cell": 8, "block": 2, "bins": 9},
  "cv_folds": 3,
  "threshold_mode": "target_recall",
  "target_recall": 0.85,
  "n_jobs": 4,
  "seed": 42
}
